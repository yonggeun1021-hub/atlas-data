{
  "schema_version": 1,
  "contract_version": "upbit_market_evidence_contract/1",
  "source_name": "upbit_market_evidence_microstructure",
  "quote_currency": "KRW",
  "market_prefix": "KRW-",
  "timeframes": ["15m", "1h", "4h", "1d"],
  "candles_minutes_endpoint_template": "https://api.upbit.com/v1/candles/minutes/{UNIT}?market={MARKET}&count={COUNT}",
  "candles_days_endpoint_template": "https://api.upbit.com/v1/candles/days?market={MARKET}&count={COUNT}",
  "candle_upbit_unit_by_timeframe": {"15m": 15, "1h": 60, "4h": 240, "1d": null},
  "candle_lookback_count_by_timeframe": {"15m": 96, "1h": 48, "4h": 30, "1d": 30},
  "trades_endpoint_template": "https://api.upbit.com/v1/trades/ticks?market={MARKET}&count={COUNT}",
  "trades_lookback_count": 50,
  "orderbook_endpoint_template": "https://api.upbit.com/v1/orderbook?markets={MARKETS}",
  "candles_raw_file_template": "upbit_candles_{TIMEFRAME}.ndjson.gz",
  "trades_raw_file": "upbit_trades.ndjson.gz",
  "orderbook_raw_file": "upbit_orderbook.json.gz",
  "capture_mode": "direct_fetch_append_only",
  "retry_max_attempts": 4,
  "retry_backoff_base_seconds": 2,
  "transform_version": "upbit_market_evidence_capture/1",
  "auth_required": false,
  "endpoints_are_public_get_only": true,
  "order_or_withdrawal_endpoints_called": false
}
