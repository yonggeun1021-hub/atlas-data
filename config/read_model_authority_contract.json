{
  "schema_version": "read_model_authority/1",
  "repository": "yonggeun1021-hub/atlas-data",
  "branch": "main",
  "canonical_ref_endpoint": "https://api.github.com/repos/yonggeun1021-hub/atlas-data/git/ref/heads/main",
  "canonical_content_endpoint_template": "https://api.github.com/repos/yonggeun1021-hub/atlas-data/contents/{path}?ref={immutable_commit_sha}",
  "cache_policy": "NO_CACHE_BRANCH_RESOLUTION_THEN_IMMUTABLE_COMMIT_PIN",
  "required_headers": {
    "Accept": "application/vnd.github+json",
    "Cache-Control": "no-cache",
    "X-GitHub-Api-Version": "2022-11-28"
  },
  "required_artifacts": [
    "data/briefing/step0_status.json",
    "data/briefing_status.json"
  ],
  "compact_path_templates": {
    "krx": "data/briefing/krx/{symbol}.json",
    "dart": "data/briefing/dart/{symbol}.json",
    "sec": "data/briefing/sec/{symbol}.json"
  },
  "stale_detection": {
    "expected_kst_date_must_match": true,
    "generation_id_must_match_across_all_artifacts": true,
    "mixed_commit_reads_forbidden": true,
    "branch_or_tag_content_fetch_forbidden": true
  },
  "authority": {
    "read_model_retrieval_only": true,
    "collector_authority": false,
    "stage_authority": false,
    "action_authority": false,
    "order_authority": false,
    "production_authority": false,
    "trading_authority": false
  }
}
