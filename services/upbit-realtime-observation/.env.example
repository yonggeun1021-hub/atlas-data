# Copy to ./.env next to compose.yaml before `docker compose up -d`.
# No secrets are needed -- Upbit's public market-data WebSocket requires no
# API key/secret. Every value below is non-secret operational configuration.

# Fallback/deep-observation baseline. By default the service discovers every
# currently listed KRW spot market from Upbit's public market-list REST API,
# subscribes all of them to ticker, and limits the higher-volume orderbook
# stream to this configured deep set. None of these markets is a candidate or
# PAPER-eligibility set.
ATLAS_UPBIT_OBS_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP,KRW-SOL,KRW-DOGE,KRW-ADA,KRW-TRX,KRW-AVAX,KRW-DOT,KRW-LINK
ATLAS_UPBIT_OBS_DEEP_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP,KRW-SOL,KRW-DOGE,KRW-ADA,KRW-TRX,KRW-AVAX,KRW-DOT,KRW-LINK
ATLAS_UPBIT_OBS_DISCOVER_ALL_KRW=true

# Public finalized-candle references only. The service retrieves completed
# 15m/1h/4h/1d candles gradually under Upbit's public REST rate limit and
# derives reference trend and 20-day BTC/peer relative strength. No API key,
# candidate promotion, PAPER eligibility, or order authority is involved.
ATLAS_UPBIT_OBS_CANDLE_INTELLIGENCE_ENABLED=true
ATLAS_UPBIT_OBS_CANDLE_REFRESH_SECONDS=1800
ATLAS_UPBIT_OBS_PUBLIC_REST_MIN_INTERVAL_SECONDS=0.14

# Loopback by default -- see README.md "Network exposure" for why exposing
# this beyond localhost is an explicit, separate operator decision (reverse
# proxy / firewall / TLS), not something this service does on its own.
ATLAS_UPBIT_OBS_BIND=127.0.0.1
ATLAS_UPBIT_OBS_PORT=8792

# Outbound-only Portal delivery. The compose file mounts the same operator
# Ed25519 key already used by the KIS realtime collector.
ATLAS_PORTAL_PUSH_URL=https://atlas.ddcloud.co.kr/api/internal/upbit-realtime-observation/snapshot
ATLAS_PUSH_INTERVAL_SECONDS=10

# Reconnect backoff: base * 2**(attempt-1), capped at max. The service
# never permanently gives up -- see observation_gate.PersistentConnectionState.
ATLAS_UPBIT_OBS_BASE_BACKOFF_SECONDS=1.0
ATLAS_UPBIT_OBS_MAX_BACKOFF_SECONDS=30.0

# How old (in seconds) the most recent accepted message for each channel may
# be before that market/kind reports STALE instead of FRESH.
ATLAS_UPBIT_OBS_TICKER_MAX_STALENESS_SECONDS=30
ATLAS_UPBIT_OBS_ORDERBOOK_MAX_STALENESS_SECONDS=15

LOG_LEVEL=INFO
