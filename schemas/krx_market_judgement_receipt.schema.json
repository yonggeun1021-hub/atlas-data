{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/krx_market_judgement_receipt/1",
  "title": "Deterministic PAPER-only KRX market-judgement receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "market",
    "run_mode",
    "evidence_class",
    "decision_at",
    "source_time",
    "as_of_date",
    "status",
    "market_judgement_status",
    "regime",
    "recommendation",
    "confidence",
    "action",
    "all_required_gates_literal_pass",
    "blocking_reasons",
    "input_envelope_sha256",
    "input_envelope",
    "authority",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "krx_market_judgement_receipt/1"},
    "contract_version": {"const": "krx_market_judgement/1"},
    "market": {"const": "KRX"},
    "run_mode": {"const": "PAPER"},
    "evidence_class": {
      "enum": ["NATURAL_READ_ONLY", "TEST_ONLY_NON_PROMOTABLE"]
    },
    "decision_at": {"type": "string", "format": "date-time"},
    "source_time": {"type": "string", "format": "date-time"},
    "as_of_date": {"type": "string", "format": "date"},
    "status": {"const": "HOLD_POLICY_OR_SOURCE_NOT_ALL_PASS"},
    "market_judgement_status": {"const": "UNKNOWN"},
    "regime": {"const": "UNKNOWN"},
    "recommendation": {"const": "HOLD"},
    "confidence": {"type": "null"},
    "action": {"type": "null"},
    "all_required_gates_literal_pass": {"const": false},
    "blocking_reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "input_envelope_sha256": {"$ref": "#/$defs/sha256"},
    "input_envelope": {"$ref": "#/$defs/inputEnvelope"},
    "authority": {"$ref": "#/$defs/authority"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "reasons"],
      "properties": {
        "name": {"type": "string"},
        "status": {"enum": ["PASS", "FAIL"]},
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "inputEnvelope": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_version",
        "market",
        "run_mode",
        "evidence_class",
        "decision_at",
        "source_time",
        "as_of_date",
        "previous_date",
        "completed_bar",
        "freshness",
        "source_lineage",
        "policy_status",
        "coverage",
        "market_evidence",
        "gates",
        "authority",
        "envelope_sha256"
      ],
      "properties": {
        "schema_version": {"const": "krx_market_judgement_input/1"},
        "contract_version": {"const": "krx_market_judgement/1"},
        "market": {"const": "KRX"},
        "run_mode": {"const": "PAPER"},
        "evidence_class": {
          "enum": ["NATURAL_READ_ONLY", "TEST_ONLY_NON_PROMOTABLE"]
        },
        "decision_at": {"type": "string", "format": "date-time"},
        "source_time": {"type": "string", "format": "date-time"},
        "as_of_date": {"type": "string", "format": "date"},
        "previous_date": {"type": "string", "format": "date"},
        "completed_bar": {
          "type": "object",
          "required": ["status", "granularity", "as_of_date", "earliest_usable_at", "reasons"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL"]},
            "granularity": {"const": "1d"},
            "as_of_date": {"type": "string", "format": "date"},
            "earliest_usable_at": {"type": "string", "format": "date-time"},
            "reasons": {"type": "array", "items": {"type": "string"}}
          }
        },
        "freshness": {
          "type": "object",
          "required": ["status", "source_age_seconds", "ttl_seconds", "ttl_policy", "reasons"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL"]},
            "source_age_seconds": {"type": "integer", "minimum": 0},
            "ttl_seconds": {"type": ["integer", "null"]},
            "ttl_policy": {"type": "string"},
            "reasons": {"type": "array", "items": {"type": "string"}}
          }
        },
        "source_lineage": {"type": "object"},
        "policy_status": {"type": "object"},
        "coverage": {
          "type": "object",
          "required": ["required_axes", "observed_axes", "required_count", "observed_count", "ratio"]
        },
        "market_evidence": {
          "type": "object",
          "required": [
            "trend", "breadth", "risk_vol", "turnover",
            "sector_relative_strength", "leadership_policy_coverage"
          ]
        },
        "gates": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/gate"}
        },
        "authority": {"$ref": "#/$defs/authority"},
        "envelope_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "paper_market_judgement_input_only",
        "market_observation_authorized",
        "source_lineage_authorized",
        "fixture_promotion_authorized",
        "market_ranking_authorized",
        "strategy_authorized",
        "candidate_authorized",
        "stage_authorized",
        "buy_authorized",
        "action_authorized",
        "proposal_authorized",
        "ledger_mutation_authorized",
        "broker_authorized",
        "order_authorized",
        "real_authorized",
        "live_authorized",
        "real_capital_authorized",
        "production_authorized",
        "trading_authorized"
      ],
      "properties": {
        "paper_market_judgement_input_only": {"const": true},
        "market_observation_authorized": {"const": true},
        "source_lineage_authorized": {"const": true},
        "fixture_promotion_authorized": {"const": false},
        "market_ranking_authorized": {"const": false},
        "strategy_authorized": {"const": false},
        "candidate_authorized": {"const": false},
        "stage_authorized": {"const": false},
        "buy_authorized": {"const": false},
        "action_authorized": {"const": false},
        "proposal_authorized": {"const": false},
        "ledger_mutation_authorized": {"const": false},
        "broker_authorized": {"const": false},
        "order_authorized": {"const": false},
        "real_authorized": {"const": false},
        "live_authorized": {"const": false},
        "real_capital_authorized": {"const": false},
        "production_authorized": {"const": false},
        "trading_authorized": {"const": false}
      },
      "additionalProperties": false
    }
  }
}
